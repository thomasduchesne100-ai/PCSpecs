<Window x:Class="PCSpecs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="PCSpecs.ico"
        Title="PCSpecs" Width="1000" Height="680" MinWidth="820" MinHeight="560"
        Background="#0B0C10" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Bouton de navigation (sidebar) -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,15" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="#C084FC" StrokeThickness="1.6" Stretch="Uniform"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17121F" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A1646" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carte d'un composant -->
        <DataTemplate x:Key="SpecCardTemplate">
            <Border Background="#12131A" BorderBrush="#22232D" BorderThickness="1"
                    CornerRadius="14" Padding="18" Margin="7" MinHeight="128">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44" CornerRadius="10" Background="#2A1646"
                            VerticalAlignment="Top" Margin="0,0,14,0">
                        <Path Data="{Binding IconData}" Stroke="#C084FC" StrokeThickness="1.6"
                              Stretch="Uniform" Width="22" Height="22"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Foreground="#C084FC"
                                   FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="{Binding Main}" Foreground="White" FontSize="16"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Details}" Foreground="#9A9CA8" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#0D0E13" BorderBrush="#1C1D25" BorderThickness="0,0,1,0">
            <Grid Margin="12,16,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,4,0,18">
                        <Border Width="38" Height="38" CornerRadius="9" Background="#2A1646">
                            <Path Data="M8,6 H16 A2,2 0 0 1 18,8 V16 A2,2 0 0 1 16,18 H8 A2,2 0 0 1 6,16 V8 A2,2 0 0 1 8,6 Z M9.5,9.5 H14.5 V14.5 H9.5 Z M9,2 V5 M15,2 V5 M9,19 V22 M15,19 V22 M2,9 H5 M2,15 H5 M19,9 H22 M19,15 H22"
                                  Stroke="#C084FC" StrokeThickness="1.6" Stretch="Uniform"
                                  Width="20" Height="20" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PCSpecs" Foreground="White" FontSize="17" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <Border Height="1" Background="#1C1D25" />
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <RadioButton x:Name="SpecsButton" Content="Specs" GroupName="nav" IsChecked="True"
                                 Tag="M12,3 L15,6 L12,9 L9,6 Z M12,15 L15,18 L12,21 L9,18 Z M3,12 L6,9 L9,12 L6,15 Z M15,12 L18,9 L21,12 L18,15 Z"
                                 Style="{StaticResource NavButton}" Margin="0,0,0,8"
                                 Click="SpecsButton_Click" />
                    <RadioButton x:Name="PerfButton" Content="Performance in use" GroupName="nav"
                                 Tag="M6.5,3.5 H17.5 A3,3 0 0 1 20.5,6.5 V17.5 A3,3 0 0 1 17.5,20.5 H6.5 A3,3 0 0 1 3.5,17.5 V6.5 A3,3 0 0 1 6.5,3.5 Z M7,15 L10.5,11 L13.5,13.5 L17,9"
                                 Style="{StaticResource NavButton}"
                                 Click="PerfButton_Click" />
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="#1C1D25" Margin="0,0,0,12" />
                    <TextBlock Text="PCSpecs Desktop" Foreground="#8A8C98" FontSize="12" Margin="8,0,0,2" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENU -->
        <Grid Grid.Column="1" Margin="21,28,21,21">

            <!-- Page Specs -->
            <Grid x:Name="SpecsPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Specs de votre PC" Foreground="White" FontSize="24"
                           FontWeight="Bold" Margin="7,0,0,13" />

                <TextBlock x:Name="LoadingText" Grid.Row="1" Text="Chargement des composants…"
                           Foreground="#9A9CA8" FontSize="14" Margin="7,0,0,0" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SpecsList" ItemTemplate="{StaticResource SpecCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Page Performance -->
            <ScrollViewer x:Name="PerfPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="7,0,7,0">
                    <TextBlock Text="Performance en cours" Foreground="White" FontSize="24"
                               FontWeight="Bold" Margin="0,0,0,20" />

                    <!-- CPU -->
                    <Border Background="#12131A" BorderBrush="#22232D" BorderThickness="1"
                            CornerRadius="14" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="CPU Usage (%)" Foreground="#C084FC" FontWeight="Bold" />
                                <TextBlock x:Name="CpuText" Text="0 %" Foreground="White"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="CpuBar" Height="10" Maximum="100" Margin="0,10,0,0"
                                         Foreground="#A855F7" Background="#22232D" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <!-- GPU -->
                    <Border Background="#12131A" BorderBrush="#22232D" BorderThickness="1"
                            CornerRadius="14" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="GPU Usage (%)" Foreground="#C084FC" FontWeight="Bold" />
                                <TextBlock x:Name="GpuText" Text="0 %" Foreground="White"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="GpuBar" Height="10" Maximum="100" Margin="0,10,0,0"
                                         Foreground="#A855F7" Background="#22232D" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <!-- RAM -->
                    <Border Background="#12131A" BorderBrush="#22232D" BorderThickness="1"
                            CornerRadius="14" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="RAM Usage (%)" Foreground="#C084FC" FontWeight="Bold" />
                                <TextBlock x:Name="RamText" Text="0 %" Foreground="White"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="RamBar" Height="10" Maximum="100" Margin="0,10,0,0"
                                         Foreground="#A855F7" Background="#22232D" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <!-- Températures -->
                    <Border Background="#12131A" BorderBrush="#22232D" BorderThickness="1"
                            CornerRadius="14" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Températures" Foreground="#C084FC" FontWeight="Bold" />
                            <TextBlock x:Name="TempText" Text="Chargement…" Foreground="White"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" />
                            <TextBlock Text="Affichées uniquement si votre PC les expose à Windows."
                                       Foreground="#9A9CA8" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
